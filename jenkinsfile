pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t devops-flask:v1 .'
            }
        }

        stage('Deploy Container') {
            steps {
                sh '''
                    docker rm -f devops-flask-container || true
                    docker run -d \
                      --name devops-flask-container \
                      -p 5000:5000 \
                      devops-flask:v1
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    sleep 5
                    curl -f http://localhost:5000
                '''
            }
        }
    }
}
